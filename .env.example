# Configure at least one server-side provider key:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
# Required shared access gate. Use a long unique value and keep it private.
APP_ACCESS_PASSWORD=
# Local Sandbox auth: vercel link && vercel env pull
VERCEL_OIDC_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
